# Copy to api/.env for local development. Never commit real values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://trailventure:trailventure@localhost:5433/trailventure
REDIS_URL=redis://localhost:6379/0
EMAIL_URL=smtp://localhost:1025
DJANGO_ADMIN_URL=django-admin/
FRONTEND_URL=http://localhost:3000
# Mailjet (production email). Leave empty to send through EMAIL_URL (Mailpit locally).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
DEFAULT_FROM_EMAIL=TrailVenture <no-reply@trailventure.local>
# Google sign-in. Authorized redirect URI: <FRONTEND_URL>/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Dev only: run Celery tasks inline (no worker needed). Set to false when running a worker.
CELERY_TASK_ALWAYS_EAGER=true
# Local mail goes to Mailpit even with Mailjet keys set; true sends through Mailjet instead.
USE_MAILJET=false
# Cloudinary (catalog images and profile photos): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Stripe (test mode). Forward the webhook locally with the `stripe listen` command in the README;
# the signing secret it prints goes in STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared key for /api/v1/bookings/expire-holds/, used where no Celery beat runs.
CRON_SECRET=
